{
  "expo": {
    "name": "Nivora Notes",
    "slug": "nivora-notes",
    "scheme": "nivora",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.nivora.notes",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Nivora Notes uses the microphone to record voice notes.",
        "NSCameraUsageDescription": "Nivora Notes uses the camera to attach photos to your notes.",
        "NSPhotoLibraryUsageDescription": "Nivora Notes lets you attach photos from your library.",
        "NSFaceIDUsageDescription": "Use Face ID to unlock Nivora Notes."
      }
    },
    "android": {
      "package": "app.nivora.notes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFD400"
      },
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFD400"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFD400"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Nivora Notes uses the microphone to record voice notes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Attach photos from your library to notes.",
          "cameraPermission": "Attach photos to notes."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock Nivora Notes."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
