{
  "name": "nivora-sync-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-knowledge sync API for Nivora Notes (Node + Neon Postgres)",
  "main": "src/index.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:memory": "STORE=memory node src/index.js",
    "db:migrate": "node scripts/migrate.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "pg": "^8.13.0"
  }
}
