# ---------- Nivora sync server ----------
# Copy to .env and fill in. NEVER commit .env.

# Neon: Dashboard -> your project -> Connect -> choose "Pooled connection" and copy the string.
# It looks like: postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Long random secret used to sign access tokens (min 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

PORT=8787
# Set to false after you and your people have registered (blocks new sign-ups).
ALLOW_REGISTRATION=true
# Set to true when running behind a reverse proxy / platform load balancer (Render, Railway, Fly, Nginx...)
TRUST_PROXY=true
# Comma separated browser origins allowed by CORS. The mobile app does not need CORS; leave empty unless you build a web client.
ALLOWED_ORIGINS=
# Use "memory" ONLY for local testing (data is lost on restart). Default is postgres.
STORE=postgres
